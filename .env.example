PSYCHOGRAM_ENVIRONMENT=development
PSYCHOGRAM_DATABASE_URL=sqlite:///./psychogram.db
PSYCHOGRAM_AUTO_CREATE_SCHEMA=false
PSYCHOGRAM_JWT_SECRET=replace-with-at-least-32-random-characters
PSYCHOGRAM_ACCESS_TOKEN_MINUTES=60
PSYCHOGRAM_BOOTSTRAP_ENABLED=false
PSYCHOGRAM_BOOTSTRAP_TOKEN=
# Generate 32 random bytes and base64-encode them; never commit the real key.
PSYCHOGRAM_PII_ENCRYPTION_KEY=
PSYCHOGRAM_PII_KEY_VERSION=v1
PSYCHOGRAM_CORS_ORIGINS=http://localhost:3000,http://localhost:5173
PSYCHOGRAM_MAX_CSV_BYTES=1000000
PSYCHOGRAM_MAX_CSV_ROWS=10000
PSYCHOGRAM_MAX_REQUEST_BODY_BYTES=3100000
